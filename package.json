{
  "name": "my-home",
  "version": "1.10.0",
  "private": true,
  "license": "MIT",
  "author": "Jianqi Pan <jannchie@gmail.com>",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "gen:dims": "vite-node scripts/gen-dims.mts",
    "gen:tags": "vite-node scripts/migrate-tags.mts",
    "gen:taxonomy": "vite-node scripts/gen-taxonomy.mts",
    "promo": "vite --config vite.promo.config.ts",
    "promo:build": "vite build --config vite.promo.config.ts",
    "promo:preview": "vite preview --config vite.promo.config.ts",
    "promo:bgm": "python scripts/promo-bgm.py promo-bgm.wav",
    "promo:record": "node scripts/record-promo.mjs"
  },
  "dependencies": {
    "@jannchie/icons": "0.11.0",
    "@jannchie/icons-vue": "0.11.0",
    "three": "^0.186.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-node": "6.0.0",
    "vitest": "4.1.10",
    "vue-tsc": "^3.3.13"
  }
}
